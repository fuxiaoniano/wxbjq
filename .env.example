# Server
HOST=127.0.0.1
PORT=8090
NODE_ENV=development
APP_PUBLIC_URL=http://127.0.0.1:8090/
APP_BASE_PATH=/
DEPLOYMENT_MODE=local

# Storage and proxy
SERVER_STORAGE_ENABLED=true
ALLOW_UNAUTHENTICATED_REMOTE_STORAGE=false
TRUSTED_ORIGINS=http://127.0.0.1:8090
TRUST_PROXY_HEADERS=false
DATA_DIR=

# Account and session security
AUTH_ENABLED=true
REGISTRATION_ENABLED=true
ALLOW_UNVERIFIED_LOGIN=true
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=wechat_editor_session
CSRF_COOKIE_NAME=wechat_editor_csrf
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
TERMS_VERSION=1
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated emails receive administrator permissions.
ADMIN_EMAILS=admin@example.com

# Email: use console only for local development. Use smtp for real registration.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=WeChat Editor
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-authorization-code

# Anti-automation extension point. "none" is the built-in development provider.
AUTOMATION_GUARD_PROVIDER=none

# Auth rate limits
REGISTER_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_15_MINUTES=10
EMAIL_RATE_LIMIT_PER_HOUR=5
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# WeChat official accounts. Generate the key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WECHAT_ENABLED=false
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key
WECHAT_CREDENTIAL_KEY_VERSION=1
WECHAT_REQUEST_TIMEOUT_MS=10000
WECHAT_TOKEN_REFRESH_SKEW_SECONDS=300
WECHAT_ACCOUNTS_HARD_MAX=50
WECHAT_DRAFT_HTML_MAX_BYTES=1048576
WECHAT_DRAFT_TEXT_MAX_CHARACTERS=20000
WECHAT_IMAGE_MAX_BYTES=1048576
WECHAT_COVER_IMAGE_MAX_BYTES=10485760
WECHAT_IMAGE_MAX_PIXELS=40000000
WECHAT_IMAGE_DOWNLOAD_TIMEOUT_MS=10000
WECHAT_IMAGE_REDIRECT_LIMIT=3

# Request and storage limits
MAX_REQUEST_BODY_BYTES=2097152
MAX_DRAFT_HTML_BYTES=1048576
MAX_TEMPLATE_HTML_BYTES=307200
MAX_DRAFTS=100
MAX_TEMPLATES=200
MAX_BROWSER_DRAFTS=80
REQUEST_READ_TIMEOUT_MS=10000
